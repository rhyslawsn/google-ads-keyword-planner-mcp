# --- Google Ads API credentials ---
# Developer token: Google Ads UI -> Tools -> API Center (manager account only)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client from Google Cloud Console (type: Desktop app)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Generate with: python get_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=
# The account Keyword Planner runs against (10 digits, dashes optional)
GOOGLE_ADS_CUSTOMER_ID=
# Only if you access the account through a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Server ---
# stdio (local, e.g. Claude Desktop) or http (remote, e.g. Railway)
MCP_TRANSPORT=stdio
# Required when MCP_TRANSPORT=http. Clients send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=
# PORT is injected by Railway; defaults to 8000
